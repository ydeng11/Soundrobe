STU希望聽眾聽歌的角度是整張專輯（album）而非其中的某幾支單曲（single），唯有聽整張專輯才能聽到TASTU音樂完整風貌。 ","released_formatted":"2000","identifiers":[{"type":"Barcode","value":"4716331005923"}],"videos":[],"genres":["Pop"],"styles":["Mandopop"],"tracklist":[{"position":"1","type_":"track","title":"music journey","duration":""},{"position":"2","type_":"track","title":"怪我","duration":""},{"position":"3","type_":"track","title":"鏡子","duration":""},{"position":"4","type_":"track","title":"someone new","duration":""},{"position":"5","type_":"track","title":"No One Else Comes Close","duration":""},{"position":"6","type_":"track","title":"愛火","duration":""},{"position":"7","type_":"track","title":"music journey(reprise)","duration":""},{"position":"8","type_":"track","title":"Never Again","duration":""},{"position":"9","type_":"track","title":"網路上癮","duration":""},{"position":"10","type_":"track","title":"放手","duration":""},{"position":"11","type_":"track","title":"give me the night","duration":""},{"position":"12","type_":"track","title":"you are my home(Live)","duration":""}],"images":[{"type":"secondary","uri":"https://i.discogs.com/Cmg2ZZh54N9mkxEEKKQjdO7SZofU-uIPDoLGd7316Og/rs:fit/g:sm/q:90/h:585/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTM3NTA1/MTY5LTE3ODAzMjUz/OTktNjczMS5qcGVn.jpeg","resource_url":"https://i.discogs.com/Cmg2ZZh54N9mkxEEKKQjdO7SZofU-uIPDoLGd7316Og/rs:fit/g:sm/q:90/h:585/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTM3NTA1/MTY5LTE3ODAzMjUz/OTktNjczMS5qcGVn.jpeg","uri150":"https://i.discogs.com/TMaJOskxsfSWQIOWA6jwgJSc2MaCCcfqFbKtqEEPLJA/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTM3NTA1/MTY5LTE3ODAzMjUz/OTktNjczMS5qcGVn.jpeg","width":600,"height":585},{"type":"secondary","uri":"https://i.discogs.com/-gOVKma5HG34hbWjhDxRNXpHLp8RGy2YtH-af7tfd4Q/rs:fit/g:sm/q:90/h:567/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTM3NTA1/MTY5LTE3ODAzMjU0/MDUtNjAyMi5qcGVn.jpeg","resource_url":"https://i.discogs.com/-gOVKma5HG34hbWjhDxRNXpHLp8RGy2YtH-af7tfd4Q/rs:fit/g