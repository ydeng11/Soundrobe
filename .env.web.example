# Copy to .env.web and keep the real file out of Git.
SOUNDROBE_IMAGE=ghcr.io/ydeng11/soundrobe:latest
SOUNDROBE_PUBLIC_URL=https://soundrobe.example.com
SOUNDROBE_PASSWORD_FILE=/absolute/path/to/soundrobe-password
SOUNDROBE_CONFIG_DIR=./data/soundrobe
SOUNDROBE_LIBRARY_1_PATH=/volume1/music
SOUNDROBE_LIBRARY_1_NAME=music
SOUNDROBE_PORT=8080
SOUNDROBE_UID=65532
SOUNDROBE_GID=65532
